---
// A framed piece on a nail. Shows the product photo when there is one and the
// logo mark until then.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata | null;
  alt?: string;
  // Above the fold on the home page, so it shouldn't be lazy-loaded there.
  eager?: boolean;
}

const { image = null, alt = '', eager = false } = Astro.props;
---

<figure class="hung">
  <svg class="hung-wire" viewBox="0 0 200 64" aria-hidden="true">
    <path d="M100 6 L8 64 M100 6 L192 64" fill="none" stroke="#1b2613" stroke-width="1.5"></path>
    <circle cx="100" cy="6" r="5" fill="#1b2613"></circle>
  </svg>
  <div class="frame">
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[420, 853]}
          sizes="(max-width: 44rem) 70vw, 24rem"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
        />
      ) : (
        <span class="mark" aria-hidden="true" />
      )
    }
  </div>
</figure>
