---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Warranty registered" noindex>
  <div class="wrap page">
    <div class="page-head">
      <h1>Your warranty is registered</h1>
      <p class="lede">
        You're covered for one year from your purchase date. There's nothing else to do.
      </p>
    </div>
    <div class="prose">
      <p>
        Keep your Amazon order confirmation as proof of purchase. If anything goes wrong, email{' '}
        <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a> with a photo and we'll sort it out.
      </p>
      <p><a href="/faq">Read the FAQ</a> or <a href="/">go back to the home page</a>.</p>
    </div>
  </div>
</Base>
