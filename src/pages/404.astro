---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="wrap page">
    <div class="page-head">
      <h1>That page isn't here</h1>
      <p class="lede">The link may be old or mistyped.</p>
    </div>
    <div class="actions">
      <a class="btn" href="/register">Register your warranty</a>
      <a class="btn btn-quiet" href="/">Go to the home page</a>
    </div>
  </div>
</Base>
